#!/bin/sh
# Capyro — desinstalador (lo instala CMake junto al binario, en bin/).
# Saca lo que instaló: el programa, el .desktop, los íconos y los ejemplos.
# Tu configuración (~/.config/capyro) NO se toca: si la querés borrar, hacelo a mano.
#
# Uso: sh capyro-uninstall            (si el prefijo es tuyo, p. ej. ~/.local)
#      sudo sh capyro-uninstall       (si Capyro está en /usr o /usr/local)

BIN=$(cd "$(dirname "$0")" && pwd)
PREFIX=$(dirname "$BIN")
SHARE="$PREFIX/share"

if [ ! -f "$BIN/capyro" ]; then
    echo "No encontré Capyro en $BIN" >&2
    exit 1
fi

rm -f "$BIN/capyro" \
      "$SHARE/applications/capyro.desktop" \
      "$SHARE/pixmaps/capyro.png"
find "$SHARE/icons/hicolor" -name 'capyro.png' -exec rm -f {} + 2>/dev/null
rm -f "$SHARE/icons/hicolor/scalable/apps/capyro.svg"
rm -rf "$SHARE/capyro"

# que el escritorio se entere (sin esto puede seguir mostrando el ícono viejo)
command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database -q "$SHARE/applications" 2>/dev/null
command -v gtk-update-icon-cache >/dev/null 2>&1 &&
    gtk-update-icon-cache -q -f -t "$SHARE/icons/hicolor" 2>/dev/null

rm -f "$BIN/capyro-uninstall"  # ya está leído: se puede borrar a sí mismo
echo "Capyro desinstalado. Tu configuración sigue en ~/.config/capyro."
