[Desktop Entry]
Type=Application
Name=Capyro
GenericName=Reproductor multimedia
GenericName[en]=Media Player
Comment=Just press play.
Keywords=video;audio;música;music;reproductor;player;mp3;mp4;
Exec=@CAPYRO_EXEC@ %F
TryExec=@CAPYRO_EXEC@
Icon=capyro
Terminal=false
StartupNotify=true
StartupWMClass=Capyro
Categories=AudioVideo;Audio;Video;Player;
# Todos los nombres con los que los gestores de archivos conocen estos
# formatos: así Capyro aparece en "Abrir con…" (y como recomendada).
MimeType=video/mp4;video/quicktime;video/x-msvideo;video/avi;video/msvideo;video/vnd.avi;audio/mpeg;audio/mp3;audio/x-mp3;audio/x-mpeg;audio/mpeg3;audio/x-mpeg-3;audio/wav;audio/x-wav;audio/wave;audio/vnd.wave;audio/ogg;audio/vorbis;audio/x-vorbis;audio/x-vorbis+ogg;application/ogg;application/x-ogg;audio/aac;audio/x-aac;audio/x-hx-aac-adts;
